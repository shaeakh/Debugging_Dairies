{
  "name": "debugging-dairies",
  "version": "1.0.0",
  "description": "\"# debugging-diaries-backend\"",
  "main": "index.js",
  "scripts": {
    "setup": "npm install && npx prisma generate && npx prisma migrate dev && npm run build && npx prisma db seed",
    "build": "prisma generate && tsc && tsc-alias",
    "vercel-build": "prisma generate && tsc && tsc-alias",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "lint": "npx eslint .",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,json,css,md}",
    "gitlog": "git log --oneline --reverse",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prepare": "node -e \"if(process.env.NODE_ENV !== 'production') { require('child_process').execSync('husky', {stdio: 'inherit'}) }\"",
    "dockers": "docker-compose up -d redis rabbitmq"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaeakh/debugging-diaries-backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/shaeakh/debugging-diaries-backend/issues"
  },
  "homepage": "https://github.com/shaeakh/debugging-diaries-backend#readme",
  "dependencies": {
    "@google/genai": "^1.43.0",
    "@google/generative-ai": "^0.24.1",
    "@openrouter/sdk": "^0.8.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.6.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.1",
    "openai": "^6.22.0",
    "pg": "^8.18.0",
    "redis": "^5.12.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
